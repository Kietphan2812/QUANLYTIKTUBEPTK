<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f0f13;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a1a24;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="ptkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff2a54;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#ff5e92;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#7b1fa2;stop-opacity:1" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#ff2a54" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- Background rounded rect -->
  <rect width="512" height="512" rx="110" fill="url(#bgGrad)"/>
  
  <!-- Outer glowing accent ring -->
  <rect x="24" y="24" width="464" height="464" rx="90" fill="none" stroke="url(#ptkGrad)" stroke-width="6" opacity="0.6"/>

  <!-- Logo Shape in center -->
  <g transform="translate(106, 106)" filter="url(#glow)">
    <!-- Rounded Box Container -->
    <rect width="300" height="180" rx="36" fill="url(#ptkGrad)"/>
    
    <!-- Play symbol inside -->
    <path d="M125 50 L210 90 L125 130 Z" fill="#ffffff"/>
    
    <!-- PTK Sub-badge -->
    <rect x="50" y="195" width="200" height="46" rx="12" fill="#1e1e2d"/>
    <text x="150" y="228" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="24" fill="#ffffff" text-anchor="middle" letter-spacing="4">TIKTUBE</text>
  </g>
</svg>
